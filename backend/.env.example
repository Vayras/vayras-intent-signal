SEARXNG_URL=http://127.0.0.1:8888
# Official Google Custom Search JSON API. Free tier: 100 queries/day.
# https://developers.google.com/custom-search/v1/introduction
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
DEMO_MODE=false
SEED_DEMO_DATA=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Meta Model API — unused while OpenAI is set
MUSESPARK_API_KEY=
MUSESPARK_MODEL=muse-spark-1.2
# Every 4 hours in-process, first scan a few seconds after boot. 0 = off.
SCAN_INTERVAL_MINUTES=240
REDDIT_SUBREDDITS=influencermarketing,IndianStartups,india,Entrepreneur,smallbusiness,marketing,startups,DTC
REDDIT_WATCH_MINUTES=15
